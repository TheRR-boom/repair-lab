  "appName": "Repair Lab",
  "webDir": "dist",
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#0b0f14"
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0b0f14"
  },
